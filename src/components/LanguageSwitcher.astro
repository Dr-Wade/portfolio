---
import Icon from './Icon.astro';
import { localeUrl, type Dictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}
const { locale, t } = Astro.props;

const options: { code: Locale; short: string; full: string }[] = [
  { code: 'en', short: 'EN', full: 'English' },
  { code: 'fr', short: 'FR', full: 'Français' },
];
const current = options.find((o) => o.code === locale)!;
---

<details class="lang">
  <summary
    class="lang__trigger"
    aria-label={t.nav.languageSwitcherLabel}
    title={t.nav.languageSwitcherLabel}
  >
    <Icon name="globe" size={17} />
    <span class="lang__code">{current.short}</span>
    <Icon name="chevron" size={14} />
  </summary>

  <ul class="lang__list" role="list">
    {
      options.map((opt) => {
        const isActive = opt.code === locale;
        return (
          <li>
            <a
              class="lang__item"
              href={localeUrl(opt.code)}
              hreflang={opt.code}
              rel="alternate"
              lang={opt.code}
              aria-current={isActive ? 'true' : undefined}
            >
              {opt.full}
              {isActive && <Icon name="check" size={15} />}
            </a>
          </li>
        );
      })
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
  }

  /* Trigger — light, matches the text nav rather than competing with it */
  .lang__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.5rem;
    border-radius: 8px;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.18s var(--ease), background 0.18s var(--ease);
  }
  .lang__trigger::-webkit-details-marker {
    display: none;
  }
  .lang__trigger:hover,
  .lang[open] .lang__trigger {
    color: var(--brand-700);
    background: var(--brand-050);
  }
  .lang__code {
    letter-spacing: 0.03em;
  }
  /* chevron flips when open */
  .lang__trigger :global(svg:last-child) {
    color: var(--muted);
    transition: transform 0.2s var(--ease);
  }
  .lang[open] .lang__trigger :global(svg:last-child) {
    transform: rotate(180deg);
  }

  /* Menu */
  .lang__list {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 60;
    min-width: 8.5rem;
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow);
    transform-origin: top right;
    animation: lang-pop 0.15s var(--ease);
  }
  @keyframes lang-pop {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.97);
    }
  }

  .lang__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.65rem;
    border-radius: 8px;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .lang__item:hover {
    background: var(--brand-050);
    color: var(--brand-700);
    text-decoration: none;
  }
  .lang__item[aria-current='true'] {
    color: var(--brand-700);
    font-weight: 600;
  }
  .lang__item :global(svg) {
    color: var(--brand);
    flex: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang__list {
      animation: none;
    }
    .lang__trigger :global(svg:last-child) {
      transition: none;
    }
  }
</style>

<script>
  // Close any open dropdown on outside-click or Escape.
  // (<details> handles toggle + Enter/Space natively.)
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    document.querySelectorAll<HTMLDetailsElement>('.lang[open]').forEach((m) => {
      if (!m.contains(target)) m.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('.lang[open]').forEach((m) => {
      m.open = false;
      m.querySelector<HTMLElement>('summary')?.focus();
    });
  });
</script>
