---
// Shared CV composition. Each locale's page passes its locale, so layout lives
// in one place and only the strings differ.
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Intro from './Intro.astro';
import Section from './Section.astro';
import Entry from './Entry.astro';
import Portfolio from './Portfolio.astro';
import Footer from './Footer.astro';
import { profile, education, languages } from '../data/cv';
import { tr, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: tr(profile.role, locale),
  worksFor: { '@type': 'Organization', name: profile.company.name, url: profile.company.url },
  url: Astro.site?.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Nancy', addressCountry: 'FR' },
  sameAs: [
    `https://github.com/${profile.github}`,
    ...(profile.linkedin ? [`https://www.linkedin.com/in/${profile.linkedin}/`] : []),
  ],
};
---

<Layout locale={locale} t={t} jsonLd={person}>
  <Header slot="header" locale={locale} t={t} />

  <div class="container">
    <Intro locale={locale} t={t} />

    <Section id="portfolio" title={t.sections.portfolio}>
      <Portfolio locale={locale} />
    </Section>

    <Section id="education" title={t.sections.education}>
      <ol class="entries">
        {education.map((entry) => <Entry entry={entry} locale={locale} t={t} />)}
      </ol>
    </Section>

    <Section id="languages" title={t.sections.languages}>
      <dl class="facts-list">
        {
          languages.map((language) => (
            <>
              <dt>{language.name[locale]}</dt>
              <dd>{language.level[locale]}</dd>
            </>
          ))
        }
      </dl>
    </Section>
  </div>

  <Footer slot="footer" />
</Layout>
