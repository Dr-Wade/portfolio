---
// Served by nginx for unknown paths (see nginx.conf `error_page 404`).
// One static file for both locales, so it carries both languages.
import Layout from '../layouts/Layout.astro';
import { localeUrl, useTranslations } from '../i18n';

const en = useTranslations('en');
const fr = useTranslations('fr');
---

<Layout locale="en" t={en} title={`${en.notFound.title} — Edward Tombre`} indexable={false}>
  <div class="container not-found">
    <h1>{en.notFound.title}</h1>
    <p>{en.notFound.body} <a href={localeUrl('en')}>{en.notFound.back}</a></p>
    <p lang="fr">{fr.notFound.body} <a href={localeUrl('fr')}>{fr.notFound.back}</a></p>
  </div>
</Layout>

<style>
  .not-found {
    padding-block: var(--space-24);
    display: grid;
    gap: var(--space-3);
  }
  .not-found h1 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    margin-bottom: var(--space-3);
  }
  .not-found p {
    color: var(--ink-soft);
  }
</style>
